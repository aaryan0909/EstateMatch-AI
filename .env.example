# Server-side only. Set this in the Vercel project settings, never in a
# VITE_* variable and never in client code. The /api functions read it.
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional, recommended for production rate limiting across serverless
# instances. Without these, rate limiting falls back to a per-instance
# in-memory bucket.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
